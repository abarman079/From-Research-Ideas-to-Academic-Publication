/* Editorial density pass: preserve the testimonial design, reduce oversized spacing. */
.section {
  padding-block: clamp(54px, 5.6vw, 86px) clamp(50px, 5.3vw, 78px);
}
.introRow {
  gap: clamp(22px, 3.2vw, 52px);
  margin-bottom: clamp(24px, 3.2vw, 42px);
}
.kicker { margin-bottom: 13px; }
.title {
  font-size: clamp(48px, 5.8vw, 78px);
  line-height: 1.08;
}
.portrait { width: clamp(160px, 16vw, 208px); border-width: 7px; }
.portraitPanel { gap: 13px; }
.featured { gap: clamp(20px, 3.2vw, 46px); }
.reviewCard {
  min-height: clamp(270px, 25vw, 352px);
  padding: clamp(28px, 3.5vw, 54px);
  border-radius: 22px 64px 22px 22px;
}
.reviewCard blockquote {
  font-size: clamp(22px, 2.2vw, 32px);
  line-height: 1.48;
  margin-bottom: clamp(17px, 2.5vw, 28px);
}
.quoteMark { font-size: clamp(88px, 10vw, 145px); }
.selectionRow { margin-top: 19px; }
.ctaRow { margin-top: clamp(21px, 2.8vw, 36px); padding-top: 19px; }
.pending { min-height: 285px; }
.pendingArt { padding: 24px clamp(20px, 2.8vw, 42px); }
.pendingArt > span:first-child { font-size: 135px; }
.pendingCopy { padding: clamp(25px, 3.5vw, 51px); }
.pendingCopy h3 { font-size: clamp(27px, 2.9vw, 40px); margin: 12px 0; }
.pendingCopy p { margin-bottom: 17px; }
:global(html[lang^='bn']) .title { line-height: 1.4; }
:global(html[lang^='bn']) .reviewCard blockquote { line-height: 1.6; }

@media (max-width: 900px) {
  .reviewCard { min-height: 0; }
  .portrait { width: 125px; }
  .introRow { gap: 15px; }
}
@media (max-width: 560px) {
  .section { padding-block: 49px 45px; }
  .title { font-size: clamp(37px, 9.4vw, 51px); }
  .introRow { margin-bottom: 25px; }
  .featured { gap: 14px; }
  .portraitPanel .portrait { width: 94px; border-width: 5px; }
  .reviewCard { padding: 25px 22px; border-radius: 18px 42px 18px 18px; }
  .reviewCard blockquote { font-size: 20px; line-height: 1.58; }
  .pending { min-height: 0; }
  .pendingArt { min-height: 82px; }
  .pendingArt > span:first-child { font-size: 78px; }
  .pendingCopy { padding: 25px 22px; }
  .pendingCopy h3 { font-size: 27px; }
  .selectionRow { margin-top: 17px; }
  .ctaRow { margin-top: 24px; }
}
